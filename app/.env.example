# =====================================================================
# CitizenTech · FIAP GS 2026.2 — variáveis de ambiente
# Copie para app/.env e preencha. NUNCA commite app/.env (está no .gitignore).
# [USUÁRIO] credencial real · [GERADO] segredo local aleatório · [FIXO] configuração sem segredo
# [OPCIONAL] tem padrão no código; só defina para mudar.
# =====================================================================

# --- Dados fora do repositório (CLAUDE.md §15) ----------------------------
CITIZENTECH_DADOS=C:\caminho\para\GS\.dados        # [FIXO] parquets, snapshots, runtime (nunca dentro do repo)
# CITIZENTECH_MERCADO_SNAPSHOT=                    # [OPCIONAL] pasta com snapshot_mercado.json e manifesto.json
# CITIZENTECH_ADZUNA_SNAPSHOT=                     # [OPCIONAL] pasta com resumo_adzuna.json e manifesto.json (D05a)
# CITIZENTECH_LIMIARES=                            # [OPCIONAL] padrão: app/config/limiares.json
# CITIZENTECH_CATALOGO=                            # [OPCIONAL] padrão: app/catalogo/destinos
# CITIZENTECH_ESCOPO_MVP=                          # [OPCIONAL] padrão: arquivo de escopo versionado
# CITIZENTECH_LEITURAS_CSV=                        # [OPCIONAL] padrão: $CITIZENTECH_DADOS/runtime/leituras.csv
# CITIZENTECH_OUTBOX_DB=                           # [OPCIONAL] padrão: ao lado do CSV de leituras
# CITIZENTECH_RATE_LIMIT_POR_MINUTO=30             # [OPCIONAL] API de leituras, por dispositivo
# CITIZENTECH_QUOTA_EXTRACAO_24H=5                 # [OPCIONAL] extrações por IA por usuário em 24 h
# CITIZENTECH_EDGE=                                # [OPCIONAL] caminho do msedge.exe para gerar PDFs

# --- LLM via OpenRouter (D06a) -----------------------------------------
OPENROUTER_API_KEY=                                  # [USUÁRIO]
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1     # [FIXO]
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017   # [FIXO] padrão (structured_outputs)
OPENROUTER_MODEL_FALLBACK=xiaomi/mimo-v2.6-flash     # [FIXO] fallback com structured_outputs
OPENROUTER_DATA_COLLECTION=deny                      # [FIXO] D22: provedores sem retenção/treino

# --- Adzuna (D05a: snapshot único, no máximo 12 chamadas; contador em $CITIZENTECH_DADOS/adzuna) ---
ADZUNA_APP_ID=                                       # [USUÁRIO]
ADZUNA_APP_KEY=                                      # [USUÁRIO]

# --- Hugging Face (Cloud, caminho A) -------------------------------------
HF_TOKEN=                                            # [USUÁRIO] token do tipo Read
HF_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
HF_API_URL=https://router.huggingface.co/hf-inference/models

# --- MongoDB Atlas (D08) ---------------------------------------------------
MONGODB_URI=                                         # [USUÁRIO] mongodb+srv://usuario:senha@cluster/...
MONGODB_DB=citizentech                               # [FIXO]

# --- Oracle local em Docker (D08, D25) -------------------------------------
ORACLE_DSN=127.0.0.1:1521/FREEPDB1                   # [FIXO] use 127.0.0.1: "localhost" tenta IPv6 e espera ~20 s
ORACLE_USER=citizentech                              # [FIXO] usuário do app (criado pelo container)
ORACLE_PASSWORD=                                     # [GERADO]
ORACLE_ADMIN_PASSWORD=                               # [GERADO] senha do SYSTEM no container

# --- Bancos de TESTE (profile "teste" do compose; ver README.md da raiz) ----
ORACLE_TESTE_USER=CT_TESTE_S9                        # [FIXO] precisa começar com CT_ e conter TESTE (trava dos testes)
ORACLE_TESTE_PASSWORD=                               # [GERADO]
POSTGRES_TESTE_PASSWORD=                             # [GERADO] porta 5433, usuário/banco citizentech_teste
MONGO_TESTE_PASSWORD=                                # [GERADO] porta 27018, usuário citizentech_teste

# --- Autenticação do app (D12) --------------------------------------------
JWT_SECRET=                                          # [GERADO]
JWT_EXPIRA_MINUTOS=60                                # [FIXO]

# --- Dispositivo IoT (D09a, D24) ------------------------------------------
DEVICE_KEY=                                          # [GERADO] FastAPI, simulador e firmware (demo)

# --- AWS Lambda + RDS (Cloud; D09) — mesmos nomes da Lambda do professor --
FUNCTION_URL=                                        # [USUÁRIO] após o deploy no Learner Lab
DB_HOST=                                             # [USUÁRIO] endpoint do RDS
DB_PORT=5432                                         # [FIXO]
DB_NAME=citizentech                                  # [FIXO]
DB_USER=app_ingest                                   # [FIXO] usuário de menor privilégio
DB_PASSWORD=                                         # [USUÁRIO] definida ao criar app_ingest
DB_SSLMODE=verify-full                               # [FIXO] D09
# DB_SSLROOTCERT=                                    # [OPCIONAL] bundle global da AWS (rds-global-bundle.pem)
# SENTIMENTO_PROVEDOR=comprehend                     # [OPCIONAL] comprehend | huggingface (variável da Lambda)
# RATE_LIMIT_POR_MINUTO=30                           # [OPCIONAL] variável da Lambda
# CITIZENTECH_LOG_LEVEL=INFO                         # [OPCIONAL] variável da Lambda
