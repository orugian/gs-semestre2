# =====================================================================
# CitizenTech · FIAP GS 2026.2 — variáveis de ambiente
# Copie para app/.env e preencha. NUNCA commite app/.env (está no .gitignore).
# Variáveis marcadas [USUÁRIO] precisam de credencial real;
# [GERADO] são segredos locais aleatórios; [FIXO] são configurações sem segredo.
# =====================================================================

# --- Execução local -----------------------------------------------------
APP_ENV=desenvolvimento                      # [FIXO] desenvolvimento | teste | demo
CITIZENTECH_DADOS=C:\Users\orugi\Documents\Projetos\FIAP\GS\.dados   # [FIXO]
CITIZENTECH_TMP=C:\Users\orugi\Documents\Projetos\FIAP\GS\.kaiser\tmp  # [FIXO]

# --- LLM via OpenRouter (D06a) -----------------------------------------
OPENROUTER_API_KEY=                         # [USUÁRIO]
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1        # [FIXO]
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017      # [FIXO] padrão (structured_outputs verificado 12/11)
OPENROUTER_MODEL_FALLBACK=xiaomi/mimo-v2.6-flash            # [FIXO] fallback com structured_outputs (escolha do usuário; verificado 12/11)
OPENROUTER_DATA_COLLECTION=deny                         # [FIXO] D22: provedores sem retenção/treino

# --- Adzuna (D05a: snapshot único, no máximo 12 chamadas) ----------------
ADZUNA_APP_ID=                               # [USUÁRIO]
ADZUNA_APP_KEY=                             # [USUÁRIO]
ADZUNA_MAX_CHAMADAS=12                                  # [FIXO]

# --- Hugging Face (Cloud, caminho A) -------------------------------------
HF_TOKEN=                                           # [USUÁRIO] token do tipo Read
HF_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment  # [FIXO] modelo indicado no enunciado
HF_API_URL=https://router.huggingface.co/hf-inference/models  # [FIXO]

# --- MongoDB Atlas M0 (D08) ----------------------------------------------
MONGODB_URI=                                     # [USUÁRIO] mongodb+srv://usuario:senha@cluster/...
MONGODB_DB=citizentech                                  # [FIXO]

# --- Oracle local em Docker (app e testes; D08, D25) ----------------------
ORACLE_DSN=localhost:1521/FREEPDB1                      # [FIXO]
ORACLE_USER=citizentech                                 # [FIXO]
ORACLE_PASSWORD=                             # [GERADO]
ORACLE_ADMIN_PASSWORD=                    # [GERADO] senha do SYSTEM no container

# --- Oracle FIAP (somente evidências da entrega de Data Science) ---------
ORACLE_FIAP_DSN=oracle.fiap.com.br:1521/ORCL            # [USUÁRIO] confirmar o serviço
ORACLE_FIAP_USER=                            # [USUÁRIO] ex.: rm572882
ORACLE_FIAP_PASSWORD=                          # [USUÁRIO]

# --- Postgres e Mongo locais de teste (profile "teste" do compose) -------
POSTGRES_TESTE_PASSWORD=                         # [GERADO] porta 5433
MONGO_TESTE_PASSWORD=                         # [GERADO] porta 27018

# --- Autenticação do app (D12) --------------------------------------------
JWT_SECRET=                                        # [GERADO]
JWT_EXPIRA_MINUTOS=60                                   # [FIXO]

# --- Dispositivo IoT (D09a, D24) ------------------------------------------
DEVICE_KEY=                                     # [GERADO] usado por FastAPI, simulador e firmware (demo)

# --- AWS Lambda + RDS (Cloud; D09) — mesmos nomes da Lambda do professor --
FUNCTION_URL=                             # [USUÁRIO] após o deploy no Learner Lab
DB_HOST=                                       # [USUÁRIO] endpoint do RDS
DB_PORT=5432                                            # [FIXO]
DB_NAME=citizentech                                     # [FIXO]
DB_USER=app_ingest                                      # [FIXO] usuário de menor privilégio
DB_PASSWORD=                                     # [USUÁRIO] definida ao criar app_ingest
DB_SSLMODE=verify-full                                  # [FIXO] D09

# --- Mercado (ML) e painel técnico R06 (S8) ---------------------------------
CITIZENTECH_MERCADO_SNAPSHOT=                           # [FIXO] diretório contendo snapshot_mercado.json e manifesto.json
CITIZENTECH_ADZUNA_SNAPSHOT=                            # [FIXO] diretório com resumo_adzuna.json e manifesto.json (D05a; opcional)
